{
  "name": "surfing-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent surfing crash game proof of concept using demo credits",
  "scripts": {
    "dev": "node scripts/prepare-fonts.mjs && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/main.js && node --check src/game-engine.js && node --check src/ocean-scene.js && npm test && npm run build",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:qa": "node tests/qa-matrix.mjs",
    "test:visual": "node tests/visual-qa.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "playwright": "1.62.1"
  }
}
